<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
        <NgbPlatformVersion>3.4.0</NgbPlatformVersion>
        <AgentApplicationRoot Condition="'$(AgentApplicationRoot)' == ''">../application</AgentApplicationRoot>
    </PropertyGroup>

    <ItemGroup>
        <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(AgentApplicationRoot)/EquipmentInspection.Api/EquipmentInspection.Api.csproj" />
        <ProjectReference Include="$(AgentApplicationRoot)/EquipmentInspection.Migrator/EquipmentInspection.Migrator.csproj" />
        <ProjectReference Include="$(AgentApplicationRoot)/EquipmentInspection.Setup/EquipmentInspection.Setup.csproj" />
        <ProjectReference Include="$(AgentApplicationRoot)/EquipmentInspection.Definitions/EquipmentInspection.Definitions.csproj" />
        <ProjectReference Include="$(AgentApplicationRoot)/EquipmentInspection.Runtime/EquipmentInspection.Runtime.csproj" />
        <ProjectReference Include="$(AgentApplicationRoot)/EquipmentInspection.PostgreSql/EquipmentInspection.PostgreSql.csproj" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="NGB.Platform.Api" Version="[$(NgbPlatformVersion)]" />
        <PackageReference Include="NGB.Platform.Runtime" Version="[$(NgbPlatformVersion)]" />
        <PackageReference Include="NGB.Platform.Persistence" Version="[$(NgbPlatformVersion)]" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
        <PackageReference Include="Testcontainers" Version="4.15.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    </ItemGroup>
</Project>
