<Project>
  <!-- Baselines exist only for previously published platform packages, not hosts or new capabilities. -->
  <PropertyGroup Condition="'$(Version)' != '$(NgbPlatformApiCompatibilityBaselineVersion)' and '$(NgbPlatformPackageKind)' != 'template' and $([System.String]::Copy('$(PackageId)').StartsWith('NGB.Platform.'))">
    <PackageValidationBaselineVersion>$(NgbPlatformApiCompatibilityBaselineVersion)</PackageValidationBaselineVersion>
    <PackageValidationBaselineVersion Condition="'$(NgbPlatformFirstStableInMajorVersion)' != ''">$(NgbPlatformFirstStableInMajorVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false' and '$(PackageId)' != ''">
    <None Include="$(MSBuildThisFileDirectory)packaging/nuget/readme/$(PackageId).md"
          Pack="true"
          PackagePath="README.md"
          Visible="false"
          Condition="Exists('$(MSBuildThisFileDirectory)packaging/nuget/readme/$(PackageId).md')" />
    <None Include="$(MSBuildThisFileDirectory)packaging/nuget/icon.png"
          Pack="true"
          PackagePath="icon.png"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE"
          Pack="true"
          PackagePath=""
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE"
          Pack="true"
          PackagePath=""
          Visible="false" />
  </ItemGroup>
</Project>
