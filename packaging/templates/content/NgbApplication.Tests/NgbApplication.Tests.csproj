<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTestProject>true</IsTestProject>
        <!-- Test the linked CLI entry point while retaining the VSTest entry point. -->
        <StartupObject>AutoGeneratedProgram</StartupObject>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Shared/ApplicationRoles.cs" Link="ApplicationRoles.cs" />
        <Compile Include="../NgbApplication.Api/ApplicationMenu.cs" Link="ApplicationMenu.cs" />
        <Compile Include="../NgbApplication.Migrator/AdministratorBootstrap.cs" Link="AdministratorBootstrap.cs" />
        <Compile Include="../infrastructure/validation/AssemblyInspector.cs" Link="AssemblyInspector.cs" />
        <Compile Include="../infrastructure/validation/Program.cs" Link="ValidationProgram.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NGB.Platform.Application.Abstractions" Version="[$(NgbPlatformVersion)]" />
        <PackageReference Include="NGB.Platform.Contracts" Version="[$(NgbPlatformVersion)]" />
        <PackageReference Include="NGB.Platform.Core" Version="[$(NgbPlatformVersion)]" />
        <PackageReference Include="NGB.Platform.Persistence" Version="[$(NgbPlatformVersion)]" />
        <PackageReference Include="NGB.Platform.Runtime" Version="[$(NgbPlatformVersion)]" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
        <PackageReference Include="Moq" Version="4.21.0" />
        <PackageReference Include="coverlet.collector" Version="10.1.0" PrivateAssets="all" />
    </ItemGroup>
</Project>
