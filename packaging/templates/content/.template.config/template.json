{
  "$schema": "http://json.schemastore.org/template",
  "author": "NGB Platform",
  "classifications": [
    "Web",
    "NGB",
    "Business"
  ],
  "identity": "NGB.Platform.Application.CSharp",
  "name": "NGB external application",
  "shortName": "ngb",
  "sourceName": "NgbApplication",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/node_modules/**",
            "**/dist/**",
            ".env",
            ".local/**",
            ".ngb/**",
            "NuGet.Local.Config",
            "web/.ngb-packages/*.tgz"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "Configure and start the application using README.md.",
      "manualInstructions": [
        {
          "text": "Read README.md, initialize private configuration and run the one-shot migrator before starting API and worker."
        }
      ],
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true
    }
  ]
}
