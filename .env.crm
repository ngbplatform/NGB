COMPOSE_PROJECT_NAME=ngb-crm

# Build
BUILD_CONFIGURATION=Release

# ASP.NET Core certificates
ASPNET_CERT_PASS=111111
ASPNET_CERT_PATH=/https/servercert.pfx

# CRM service host ports
CRM_API_HTTP_PORT=5060
CRM_API_HTTPS_PORT=7080
CRM_BACKGROUNDJOBS_HTTP_PORT=5061
CRM_BACKGROUNDJOBS_HTTPS_PORT=7081
CRM_WATCHDOG_HTTP_PORT=5062
CRM_WATCHDOG_HTTPS_PORT=7082
CRM_WEB_HTTP_PORT=5176

# Seq
SEQ_IMAGE_TAG=2025.2
SEQ_HTTP_HOST_PORT=5344
SEQ_URL=http://ngb.crm.seq
SEQ_API_KEY=1f92ff68-ff3f-44bd-90a7-06584a530e6b
SEQ_DEFAULT_ADMIN_NAME=user@example.com
SEQ_DEFAULT_ADMIN_PASSWORD=Password(55)60-stronG-start

# PostgreSQL
POSTGRES_IMAGE_TAG=18.3-alpine
POSTGRES_HOST_PORT=5435
POSTGRES_SHM_SIZE=4gb
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SUPERUSER_RESERVED_CONNECTIONS=5
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_ADMIN_USER=ngb_platform_admin
POSTGRES_ADMIN_PASSWORD=Password(55)60-stronG-db
CRM_DB_NAME=ngb_crm
CRM_DB_USER=ngb_crm_app
CRM_DB_PASSWORD=Password(55)60-stronG-crm
CRM_API_DB_POOL_MIN=20
CRM_API_DB_POOL_MAX=160
CRM_API_DB_CONNECT_TIMEOUT_SECONDS=15
CRM_API_DB_COMMAND_TIMEOUT_SECONDS=60
CRM_BACKGROUNDJOBS_DB_POOL_MIN=2
CRM_BACKGROUNDJOBS_DB_POOL_MAX=20
CRM_BACKGROUNDJOBS_DB_CONNECT_TIMEOUT_SECONDS=15
CRM_BACKGROUNDJOBS_DB_COMMAND_TIMEOUT_SECONDS=120
KEYCLOAK_DB_NAME=ngb_crm_keycloak
KEYCLOAK_DB_USER=ngb_crm_keycloak_app
KEYCLOAK_DB_PASSWORD=Password(55)60-stronG-crm-kc
KEYCLOAK_DB_POOL_INITIAL_SIZE=2
KEYCLOAK_DB_POOL_MIN_SIZE=2
KEYCLOAK_DB_POOL_MAX_SIZE=20

# pgAdmin
PGADMIN_IMAGE_TAG=9.14
PGADMIN_HTTP_HOST_PORT=4884
PGADMIN_DEFAULT_EMAIL=user@example.com
PGADMIN_DEFAULT_PASSWORD=Password(55)60-stronG

# CRM demo bootstrap
CRM_DEMO_SEED_ENABLED=true
CRM_DEMO_SEED=20260412

# Keycloak
KEYCLOAK_IMAGE_TAG=26.5.6
KEYCLOAK_HTTP_HOST_PORT=7014
KEYCLOAK_PUBLIC_HOST=crm-keycloak.localhost
KEYCLOAK_INTERNAL_URL=http://ngb.crm.keycloak:8080
KEYCLOAK_PUBLIC_URL=http://crm-keycloak.localhost:7014
KEYCLOAK_LOG_LEVEL=info
KEYCLOAK_MASTER_ADMIN_USERNAME=admin
KEYCLOAK_MASTER_ADMIN_PASSWORD=Password(55)60-stronG
KEYCLOAK_REALM=ngb-demo
KEYCLOAK_REALM_DISPLAY_NAME=NGB Demo
KEYCLOAK_REALM_DISPLAY_NAME_HTML=<strong>NGB Demo</strong>
KEYCLOAK_THEME_NAME=ngb-auth
KEYCLOAK_SSL_REQUIRED=external
KEYCLOAK_ACCESS_TOKEN_LIFESPAN_SECONDS=3600
KEYCLOAK_LOGIN_WITH_EMAIL_ALLOWED=true
KEYCLOAK_REGISTRATION_ALLOWED=false
KEYCLOAK_REGISTRATION_EMAIL_AS_USERNAME=true
KEYCLOAK_RESET_PASSWORD_ALLOWED=true
KEYCLOAK_VERIFY_EMAIL=false
KEYCLOAK_REMEMBER_ME=true
KEYCLOAK_BRUTE_FORCE_PROTECTED=true
KEYCLOAK_CRM_API_CLIENT_ID=ngb-crm-api
KEYCLOAK_CRM_WEB_CLIENT_ID=ngb-crm-web-client
KEYCLOAK_CRM_BACKGROUND_JOBS_CLIENT_ID=ngb-crm-background-jobs
KEYCLOAK_CRM_WATCHDOG_CLIENT_ID=ngb-crm-watchdog
KEYCLOAK_TESTER_CLIENT_ID=ngb-tester
KEYCLOAK_TESTER_CLIENT_SECRET=ngb-crm-tester-secret-2026
KEYCLOAK_DEMO_ADMIN_ID=6d49204b-867c-4180-a30d-a5e290e13c73
KEYCLOAK_DEMO_ADMIN_USERNAME=alex.carter@demo.ngbplatform.com
KEYCLOAK_DEMO_ADMIN_FIRST_NAME=Alex
