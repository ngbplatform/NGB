{
  "ConnectionStrings": {
    "DefaultConnection": "<value_to_be_substituted_from_env_file>"
  },
  "KeycloakSettings": {
    "Issuer": "<value_to_be_substituted_from_env_file>",
    "ClientIds": [ "ngb-crm-background-jobs" ]
  },
  "BackgroundJobs": {
    "Enabled": true,
    "DefaultTimeZoneId": "UTC",
    "Jobs": {
      "platform.schema.validate": {
        "Cron": "0 3 * * *",
        "Enabled": true,
        "TimeZoneId": "UTC"
      },
      "audit.health": {
        "Cron": "15 3 * * *",
        "Enabled": true,
        "TimeZoneId": "UTC"
      },
      "refreg.ensure_schema": {
        "Cron": "30 3 * * *",
        "Enabled": true,
        "TimeZoneId": "UTC"
      }
    }
  }
}
