    "@vitest/browser-playwright": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "playwright": "1.59.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.10",
    "vitest-browser-vue": "^2.1.0"
