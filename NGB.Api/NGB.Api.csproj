<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPublishable>false</IsPublishable>
        <PackageId>NGB.Platform.Api</PackageId>
        <Description>Reusable ASP.NET Core API building blocks for NGB Platform hosts, including base controllers, SSO integration, health checks, and global error handling.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
        <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
        <PackageReference Include="IdentityModel" Version="5.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\NGB.Contracts\NGB.Contracts.csproj"/>
        <ProjectReference Include="..\NGB.Application.Abstractions\NGB.Application.Abstractions.csproj"/>
        <ProjectReference Include="..\NGB.Core\NGB.Core.csproj" />
        <ProjectReference Include="..\NGB.Runtime\NGB.Runtime.csproj" />
        <ProjectReference Include="..\NGB.Tools\NGB.Tools.csproj"/>
    </ItemGroup>

</Project>
