# NGB target
NGB_BASE_URL=http://localhost:5173
NGB_API_BASE_URL=https://localhost:7071
NGB_VERTICAL=property-management

# Keycloak / OIDC token endpoint
KEYCLOAK_TOKEN_URL=http://pm-keycloak.localhost:7012/realms/ngb-demo/protocol/openid-connect/token
KEYCLOAK_TESTER_CLIENT_ID=ngb-tester
KEYCLOAK_TESTER_CLIENT_SECRET=replace-me

# Test user
NGB_TEST_USERNAME=perf.manager@example.com
NGB_TEST_PASSWORD=replace-me

# Optional test behavior
NGB_TEST_TENANT_CODE=demo
NGB_TEST_COMPANY_CODE=demo
NGB_K6_SUMMARY_EXPORT=artifacts/k6-summary.json
NGB_K6_ENV=local
NGB_K6_HOST_ALIASES=pm-keycloak.localhost=127.0.0.1
NGB_K6_INSECURE_SKIP_TLS_VERIFY=true
NGB_PERF_ENABLE_WRITES=false
NGB_PERF_ENABLE_POSTING=false
NGB_PERF_ENABLE_PERIOD_CLOSE=false
NGB_PERF_ENABLE_CASH_FLOW=false
NGB_PERF_ENABLE_EXTENDED_CASH_FLOW=false
NGB_PERF_DELETE_CREATED_DRAFTS=true

# Optional write-heavy profile overrides. Defaults are documented in README.md.
NGB_PM_WRITE_HEAVY_DURATION=
NGB_PM_WRITE_HEAVY_LIFECYCLE_RATE=
NGB_PM_WRITE_HEAVY_LIFECYCLE_TIME_UNIT=
NGB_PM_WRITE_HEAVY_LIFECYCLE_PRE_ALLOCATED_VUS=
NGB_PM_WRITE_HEAVY_LIFECYCLE_MAX_VUS=
NGB_PM_WRITE_HEAVY_POSTING_RATE=
NGB_PM_WRITE_HEAVY_POSTING_TIME_UNIT=
NGB_PM_WRITE_HEAVY_POSTING_PRE_ALLOCATED_VUS=
NGB_PM_WRITE_HEAVY_POSTING_MAX_VUS=
NGB_PM_WRITE_HEAVY_READBACK_RATE=
NGB_PM_WRITE_HEAVY_READBACK_TIME_UNIT=
NGB_PM_WRITE_HEAVY_READBACK_PRE_ALLOCATED_VUS=
NGB_PM_WRITE_HEAVY_READBACK_MAX_VUS=
NGB_PM_WRITE_HEAVY_REPORTING_RATE=
NGB_PM_WRITE_HEAVY_REPORTING_TIME_UNIT=
NGB_PM_WRITE_HEAVY_REPORTING_PRE_ALLOCATED_VUS=
NGB_PM_WRITE_HEAVY_REPORTING_MAX_VUS=

# Reproducible performance windows.
# Open profile defaults to current UTC month-to-date when these are empty.
NGB_PERF_FROM_UTC=
NGB_PERF_TO_UTC=
NGB_PERF_AS_OF_UTC=
NGB_PERF_PERIOD_UTC=

# Closed profile defaults to previous UTC month when these are empty.
NGB_PERF_CLOSED_FROM_UTC=
NGB_PERF_CLOSED_TO_UTC=
NGB_PERF_CLOSED_AS_OF_UTC=
NGB_PERF_CLOSED_PERIOD_UTC=

# Long profile defaults to last 12 UTC months when these are empty.
NGB_PERF_LONG_FROM_UTC=
NGB_PERF_LONG_TO_UTC=
NGB_PERF_LONG_AS_OF_UTC=
NGB_PERF_LONG_PERIOD_UTC=

# Optional stable PM fixture IDs for write/heavy read flows
NGB_PM_FIXTURE_LEASE_ID=
NGB_PM_FIXTURE_RENT_CHARGE_ID=
NGB_PM_FIXTURE_RECEIVABLE_PAYMENT_ID=
NGB_PM_FIXTURE_AUDIT_DOCUMENT_ID=
NGB_PM_FIXTURE_PROPERTY_ID=
NGB_PM_FIXTURE_PARTY_ID=
NGB_PM_FIXTURE_TENANT_PARTY_ID=
NGB_PM_FIXTURE_MAINTENANCE_CATEGORY_ID=

# Optional stable accounting fixture for account-specific platform reports
NGB_ACCOUNT_FIXTURE_ACCOUNT_ID=
