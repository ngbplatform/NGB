# NGB target
NGB_BASE_URL=http://localhost:5174
NGB_API_BASE_URL=https://localhost:7072
NGB_VERTICAL=trade

# Keycloak / OIDC token endpoint
KEYCLOAK_TOKEN_URL=http://keycloak.localhost:7011/realms/ngb-demo/protocol/openid-connect/token
KEYCLOAK_TESTER_CLIENT_ID=ngb-tester
KEYCLOAK_TESTER_CLIENT_SECRET=replace-me

# Test user
NGB_TEST_USERNAME=perf.manager@example.com
NGB_TEST_PASSWORD=replace-me

# Optional test behavior
NGB_TEST_TENANT_CODE=demo
NGB_TEST_COMPANY_CODE=demo
NGB_K6_SUMMARY_EXPORT=artifacts/k6-summary.json
NGB_K6_ENV=local
NGB_K6_HOST_ALIASES=keycloak.localhost=127.0.0.1
NGB_K6_INSECURE_SKIP_TLS_VERIFY=true
NGB_PERF_ENABLE_WRITES=false
