{
  "name": "ngb-performance-tests",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "workspaces": [
    "ngb-performance-tests-framework",
    "ngb-property-management-perf",
    "ngb-trade-perf",
    "ngb-agency-billing-perf"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "pm:smoke": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/smoke.ts",
    "pm:baseline": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/baseline.ts",
    "pm:load": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/load.ts",
    "pm:stress": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/stress.ts",
    "pm:spike": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/spike.ts",
    "pm:soak": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/soak.ts",
    "pm:business-day": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/business-day.ts",
    "pm:reporting-regression": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/reporting-regression.ts",
    "pm:platform-read": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/platform-read.ts",
    "pm:platform-read-capacity": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/platform-read-capacity.ts",
    "pm:platform-mixed-capacity": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/platform-mixed-capacity.ts",
    "pm:platform-breakpoint": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/platform-breakpoint.ts",
    "pm:max": "npm run pm:platform-read-capacity && npm run pm:platform-mixed-capacity && npm run pm:platform-breakpoint",
    "pm:platform-reporting": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/platform-reporting.ts",
    "pm:document-lifecycle": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/document-lifecycle.ts",
    "pm:audit": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/audit.ts",
    "pm:maintenance": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/maintenance.ts",
    "pm:concurrency": "./scripts/run-k6.sh --env-file ngb-property-management-perf/.env.local --test ngb-property-management-perf/src/tests/concurrency.ts",
    "pm:all": "npm run pm:smoke && npm run pm:baseline && npm run pm:platform-read && npm run pm:platform-reporting && npm run pm:document-lifecycle && npm run pm:audit && npm run pm:maintenance && npm run pm:load && npm run pm:stress && npm run pm:spike && npm run pm:business-day",
    "trade:smoke": "./scripts/run-k6.sh --env-file ngb-trade-perf/.env.local --test ngb-trade-perf/src/tests/smoke.ts",
    "ab:smoke": "./scripts/run-k6.sh --env-file ngb-agency-billing-perf/.env.local --test ngb-agency-billing-perf/src/tests/smoke.ts"
  },
  "devDependencies": {
    "@types/k6": "latest",
    "typescript": "latest"
  }
}
