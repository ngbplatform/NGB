<Project>
  <PropertyGroup>
    <!-- Product / release version -->
    <Version>1.3.1</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <!-- NuGet packages -->
    <NgbPlatformPackageVersion>$(Version)</NgbPlatformPackageVersion>
    <PackageVersion>$(NgbPlatformPackageVersion)</PackageVersion>
    <Authors>NGB Platform</Authors>
    <Company>NGB Platform</Company>
    <Product>NGB Platform</Product>
    <PackageProjectUrl>https://ngbplatform.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ngbplatform/NGB</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>NGB;NGB Platform;.NET;PostgreSQL;business applications</PackageTags>
    <PackageReleaseNotes>Ensure packaged dashboard stylesheets are included in consuming application publish output.</PackageReleaseNotes>
    <Copyright>Copyright (c) NGB Platform 2026</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
