# Local development only. Set different values in production secret management.
MINIO_ROOT_USER=ngb-local-root
MINIO_ROOT_PASSWORD=ngb-local-root-development-only
MINIO_APP_ACCESS_KEY=ngb-local-app
MINIO_APP_SECRET_KEY=ngb-local-app-development-only
MINIO_BUCKET=ngb-attachments
# Default ports: PM 9100, Trade 9200, AB 9300, CRM 9400.
MINIO_HTTP_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_PUBLIC_ENDPOINT=http://localhost:9100
MINIO_CORS_ORIGINS=http://localhost:5173
