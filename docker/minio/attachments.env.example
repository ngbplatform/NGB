# Production API environment example. Local Compose settings live in .env.{pm,trade,ab,crm}.
# Features are disabled by default. Apply changes by restarting the API.
FeatureManagement__Attachments=true
FeatureManagement__Notes=true
# Keep cleanup running when disabling Attachments after it has been used.
Attachments__MaintenanceEnabled=true

# All verticals use the existing shared MinIO S3 endpoint.
Attachments__MinIO__InternalEndpoint=https://minio.ngbplatform.com
Attachments__MinIO__PublicEndpoint=https://minio.ngbplatform.com
Attachments__MinIO__AllowInsecureHttp=false

# Example only: use the actual bucket and dedicated application credentials for this vertical.
# Supply credentials through the deployment's secret management, never the MinIO root account.
Attachments__MinIO__Bucket=ngb-pm-attachments
Attachments__MinIO__AccessKey=
Attachments__MinIO__SecretKey=
