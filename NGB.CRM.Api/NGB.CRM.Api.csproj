<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\NGB.CRM\NGB.CRM.csproj" />
        <ProjectReference Include="..\NGB.CRM.PostgreSql\NGB.CRM.PostgreSql.csproj" />
        <ProjectReference Include="..\NGB.CRM.Runtime\NGB.CRM.Runtime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NGB.Platform.Api" Version="$(NgbPlatformPackageVersion)" />
        <PackageReference Include="NGB.Platform.Application.Abstractions" Version="$(NgbPlatformPackageVersion)" />
        <PackageReference Include="NGB.Platform.Contracts" Version="$(NgbPlatformPackageVersion)" />
        <PackageReference Include="NGB.Platform.PostgreSql" Version="$(NgbPlatformPackageVersion)" />
        <PackageReference Include="NGB.Platform.PostgreSql.AspNetCore" Version="$(NgbPlatformPackageVersion)" />
        <PackageReference Include="NGB.Platform.Runtime" Version="$(NgbPlatformPackageVersion)" />
        <PackageReference Include="NGB.Platform.Runtime.Hosting" Version="$(NgbPlatformPackageVersion)" />
        <PackageReference Include="NGB.Platform.Tools" Version="$(NgbPlatformPackageVersion)" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.Development.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.Production.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

</Project>
